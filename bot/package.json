{
  "name": "finch-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../.env --import tsx src/index.ts",
    "dev": "node --env-file=../.env --watch --import tsx src/index.ts",
    "serve": "node --env-file=../.env --import tsx src/http.ts",
    "serve:dev": "node --env-file=../.env --watch --import tsx src/http.ts",
    "mcp": "node --env-file=../.env --import tsx src/mcp.ts",
    "testagent": "node --env-file=../.env --import tsx src/testagent.ts",
    "serve:prod": "node --import tsx src/http.ts",
    "start:prod": "node --import tsx src/index.ts",
    "mcp:prod": "node --import tsx src/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.23.1",
    "grammy": "^1.30.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
