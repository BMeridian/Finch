# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- The Graph / subgraph deploy ----
GRAPH_DEPLOY_KEY=            # Subgraph Studio "Deploy key" — for `graph deploy`
GRAPH_QUERY_KEY=            # Graph gateway API key — for querying the deployed subgraph (NLI layer)
GOLDSKY_API_KEY=            # fallback indexer, if Robinhood Chain not in Studio

# ---- Robinhood Chain ----
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
SUBGRAPH_QUERY_URL=          # deployed subgraph GraphQL endpoint (filled after deploy)
SUBGRAPH_LIVE_URL=            # short recent-window subgraph; kept fresh for recent-launch queries

# ---- Blockscout (verification + mapping reference) ----
BLOCKSCOUT_API_BASE=https://api.blockscout.com
BLOCKSCOUT_API_KEY=          # free tier from dev.blockscout.com

# ---- NLI query layer (LLM for NL -> GraphQL -> NL) ----
OPENROUTER_API_KEY=          # openrouter.ai — primary
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=           # optional, if calling Anthropic directly instead

# ---- Telegram bot (@FinchBot) ----
TELEGRAM_BOT_TOKEN=          # from @BotFather

# ---- Bazantic ----
BAZANTIC_API_KEY=

# Finch HTTP API (the endpoint Bazantic wraps)
FINCH_HTTP_PORT=8787
