# /etc/finch/finch.env  — read by the systemd units (and by Caddy via a drop-in).
# NOT committed with real values. Fill on the box.

# public hostname Caddy serves + gets a cert for. Free option, no domain:
#   <dash-separated-ipv4>.sslip.io   e.g.  203-0-113-5.sslip.io
FINCH_HOSTNAME=

SUBGRAPH_QUERY_URL=https://api.goldsky.com/api/public/project_cmtp3v04cmqa101vr9xgv7rvm/subgraphs/finch-rpc/0.4.0/gn
SUBGRAPH_LIVE_URL=https://api.goldsky.com/api/public/project_cmtp3v04cmqa101vr9xgv7rvm/subgraphs/finch-live/0.2.0/gn
RPC_URL=https://rpc.mainnet.chain.robinhood.com
FINCH_HTTP_PORT=8787
FINCH_SKILL_PATH=/home/ec2-user/_Finch/SKILL.md
FINCH_SPEC_PATH=/home/ec2-user/_Finch/bazantic/openapi.json

# Telegram bot (only needed for finch-bot.service)
TELEGRAM_BOT_TOKEN=

# optional — prose rephrasing of non-canonical answers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
