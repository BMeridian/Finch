[Unit]
Description=Finch Substreams sink (Pinax -> Postgres, pure Substreams live path)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/_Finch/substreams
EnvironmentFile=/etc/finch/finch.env
# Pinax caps concurrent streams on this key -> 1 parallel worker + always-restart
# absorbs the intermittent ResourceExhausted. No stop block: picks up from the
# Neon cursor if present, else --start-block. Start block = the Goldsky seed's
# head (bot/scripts/seed-from-goldsky.mjs, SEED_MAX_BLOCK) so the Substreams sink
# owns everything from there forward with no overlap.
ExecStart=/usr/local/bin/substreams sink postgres \
  --dsn=${SUBSTREAMS_SINK_DSN} \
  -e ${SUBSTREAMS_ENDPOINT} \
  --start-block=58436370 \
  -H "X-Substreams-Parallel-Workers: 1" \
  /home/ec2-user/_Finch/substreams/finch-substreams-v0.1.0.spkg map_events
Restart=always
RestartSec=15
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
