[Unit]
Description=Finch HTTP API (Bazantic gateway upstream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/_Finch/bot
EnvironmentFile=/etc/finch/finch.env
ExecStart=/usr/bin/npm run serve:prod
Restart=always
RestartSec=3
# keep the write files out of the synced tree
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
